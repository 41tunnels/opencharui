{
  "type": "module",
  "name": "opencharui",
  "version": "1.0.1",
  "description": "Local roleplay chat with Ollama",
  "author": "tehfonsi",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/41tunnels/opencharui.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "cross-env VITE_LAN_HTTPS=true vite --host",
    "build": "vue-tsc --noEmit -p tsconfig.web.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "jsqr": "^1.4.0",
    "pinia": "^3.0.2",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.1",
    "postcss": "^8.5.4",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.10"
  }
}
